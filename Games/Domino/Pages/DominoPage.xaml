<ContentPage x:Class="SolitaireNET.DominoPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#0B6B3A"
             Title="Dominó">

    <Grid>
        <GraphicsView x:Name="Mesa"
                      BackgroundColor="#0B6B3A"
                      StartInteraction="Mesa_StartInteraction" />

        <Border HorizontalOptions="End"
                VerticalOptions="End"
                Margin="8"
                Padding="6"
                BackgroundColor="#AA000000"
                StrokeShape="RoundRectangle 8">

            <HorizontalStackLayout Spacing="6">
                <Button Text="Passar"
                        FontSize="12"
                        Padding="8,4"
                        HeightRequest="34"
                        Clicked="Passar_Clicked" />

                <Button Text="Novo"
                        FontSize="12"
                        Padding="8,4"
                        HeightRequest="34"
                        Clicked="Novo_Clicked" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>